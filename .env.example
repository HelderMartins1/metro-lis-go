# Cais server settings. Copy to .env next to the binary (on the server:
# /var/www/cais/.env) and fill in. Variables already set in the environment win.

# Metro de Lisboa API credentials.
METRO_API_URL=
METRO_API_TOKEN=

# Without credentials, take live data from another Cais server instead.
# METRO_BACKEND_URL=https://api.caislx.tech

# Port the server listens on (nginx proxies api.caislx.tech to it).
PORT=8081

# Sites allowed to call the API from a browser, comma-separated. Empty allows any.
CORS_ORIGINS=https://caislx.tech

# Where push notifications keep their keys and subscriptions. Must survive deploys:
# losing it turns off everyone's notifications.
CAIS_DATA_DIR=/var/www/cais/data

# How push services (Apple, Google, Mozilla) can reach whoever runs this server.
CAIS_PUSH_CONTACT=https://caislx.tech
